# Realtime System & GPU Monitor - Environment Variables

# External Ports (start.sh rewrites these if the port is already in use)
FRONTEND_PORT=3000
BACKEND_PORT=8000

# WebSocket Server URL
# If left empty, the frontend connects to the current browser's host on BACKEND_PORT.
# Example override: NEXT_PUBLIC_WS_URL=ws://192.168.1.100:8000/ws
NEXT_PUBLIC_WS_URL=
